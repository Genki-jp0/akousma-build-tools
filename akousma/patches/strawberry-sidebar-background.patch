+    blurred.fill(Qt::transparent);
+    QPainter blur_painter(&blurred);
+    qt_blurImage(&blur_painter, source, bg_image_blur_radius_, true, false);
+    blur_painter.end();
+    image = blurred;
+  }
+
+  bg_image_ = image.isNull() ? QPixmap() : QPixmap::fromImage(image);
+
+}
